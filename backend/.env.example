# ===== Servidor =====
# Render asigna el puerto automáticamente vía la variable PORT.
PORT=3000

# ===== Base de datos (Supabase / Postgres) =====
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=6543
# SSL: déjalo vacío o "true" en la nube (Supabase lo exige). Usa "false" solo en local sin SSL.
DB_SSL=true

# ===== Autenticación =====
# Genera uno aleatorio y largo, p. ej.: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=10h

# ===== Cloudinary (imágenes) =====
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# ===== CORS =====
# Dominios del frontend permitidos, separados por coma.
# Ej: https://punto-picante.vercel.app,http://localhost:5173
CORS_ORIGINS=
